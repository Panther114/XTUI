{
  "manifest_version": 3,
  "name": "XTUI Browser Bridge",
  "version": "0.3.7",
  "description": "Uses your existing X session to power the XTUI terminal client.",
  "key": "",
  "permissions": ["alarms", "cookies", "nativeMessaging", "storage", "tabs"],
  "host_permissions": ["https://x.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*"],
      "js": ["timeline.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "XTUI Browser Bridge",
    "default_popup": "popup.html"
  }
}
